# Copie para .env e preencha. O .env nunca vai para o git (RNF05).

# Origens do front-end liberadas no CORS (várias, separadas por vírgula)
CORS_ORIGIN=http://localhost:5173
# Opcional: expressão regular para liberar os previews do front-end no Vercel
# Exemplo: ^https://proced-web-[a-z0-9-]+-seu-time\.vercel\.app$
CORS_ORIGIN_REGEX=

# Supabase (só o back-end conhece estes valores; o front-end nunca acessa o banco, RNF10)
SUPABASE_URL=https://lpvquffmhzfalqtzydae.supabase.co
# Chave secreta (sb_secret_...), em Supabase > Project Settings > API Keys
SUPABASE_SECRET_KEY=
